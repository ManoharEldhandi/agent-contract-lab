{
  "name": "agent-contract-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first evidence and contract testing for AI coding agents",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/local-supervisor"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "npm run build && npm run test:workspaces",
    "test:workspaces": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "^6.0.3"
  }
}
