{
  "name": "agent-contract-lab",
  "publisher": "manohareldhandi",
  "displayName": "Agent Contract Lab",
  "description": "Evidence-based contracts for AI coding agents",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManoharEldhandi/agent-contract-lab.git"
  },
  "homepage": "https://github.com/ManoharEldhandi/agent-contract-lab#readme",
  "bugs": {
    "url": "https://github.com/ManoharEldhandi/agent-contract-lab/issues"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "AI",
    "agent",
    "Codex",
    "policy",
    "contracts",
    "observability",
    "privacy"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agent-contract-lab.startMonitoredRun",
        "title": "Start Monitored Run",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.startCodexSession",
        "title": "Log a Codex Task",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.connectSupervisor",
        "title": "Connect Local Supervisor",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.trustWorkspace",
        "title": "Trust Workspace for Managed Runs",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.refreshSessions",
        "title": "Refresh Recorded Sessions",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.openSessionLog",
        "title": "Open Session Log",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.openEffectiveInstructions",
        "title": "Open Effective Instructions",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.runContractSuite",
        "title": "Run Contract Suite",
        "category": "Agent Contract Lab"
      },
      {
        "command": "agent-contract-lab.exportEvidenceBundle",
        "title": "Export Evidence Bundle",
        "category": "Agent Contract Lab"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-contract-lab",
          "title": "Agent Contracts",
          "icon": "media/agent-contract-lab.svg"
        }
      ]
    },
    "views": {
      "agent-contract-lab": [
        {
          "id": "agent-contract-lab.session",
          "name": "Session"
        },
        {
          "id": "agent-contract-lab.instructions",
          "name": "Effective Instructions"
        },
        {
          "id": "agent-contract-lab.policies",
          "name": "Policies"
        },
        {
          "id": "agent-contract-lab.contracts",
          "name": "Contracts"
        }
      ]
    },
    "configuration": {
      "title": "Agent Contract Lab",
      "properties": {
        "agent-contract-lab.supervisorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:43199",
          "description": "Loopback URL for the local Agent Contract Lab supervisor.",
          "scope": "machine"
        },
        "agent-contract-lab.codex.defaultDurationMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 240,
          "description": "Maximum duration for a supervisor-managed Codex task.",
          "scope": "machine"
        },
        "agent-contract-lab.codex.defaultTokenBudget": {
          "type": "number",
          "default": 50000,
          "minimum": 1,
          "maximum": 2000000,
          "description": "Maximum reported token budget for a supervisor-managed Codex task.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:packages && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:packages && npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run build:packages && npm run compile-tests && npm run compile && npm run lint",
    "build:packages": "npm --prefix ../.. run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@agent-contract-lab/event-schema": "file:../../packages/event-schema"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
